<Window x:Class="MarchLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MARCH ROLE PLAY | Launcher" Width="1180" Height="720" MinWidth="1020" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="#080E17" Foreground="White" Opacity="0">
 <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard><Storyboard>
 <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.65" DecelerationRatio="0.8"/>
 </Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#263746"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".82"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#192A37"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#36515C"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="14"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#152F3E" Offset="0"/><GradientStop Color="#101B2B" Offset=".42"/>
   <GradientStop Color="#080E17" Offset="1"/>
  </LinearGradientBrush></Grid.Background>
  <Canvas IsHitTestVisible="False" ClipToBounds="True">
   <Ellipse Width="780" Height="780" Canvas.Left="-350" Canvas.Top="-300" Opacity=".17">
    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1EF1D0"/><GradientStop Color="#1EF1D0" Offset=".1"/><GradientStop Color="#001EF1D0" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
   </Ellipse>
   <Ellipse Width="650" Height="650" Canvas.Right="-250" Canvas.Bottom="-350" Opacity=".19">
    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#F69C65"/><GradientStop Color="#00F69C65" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
   </Ellipse>
  </Canvas>
  <Grid Margin="36,26,36,24">
   <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
     <Border Background="#22DCC9" Width="7" Height="39" CornerRadius="3" Margin="0,0,16,0"/>
     <StackPanel><TextBlock Text="MARCH" FontWeight="Black" FontSize="30" Foreground="#45F1D5" LineHeight="32"/>
      <TextBlock Text="ROLE PLAY" FontWeight="SemiBold" FontSize="12" Foreground="#E5F4F6"/></StackPanel>
    </StackPanel>
    <TextBlock Text="ОФИЦИАЛЬНЫЙ ЛАУНЧЕР  •  WINDOWS" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8EA8B6" FontSize="12"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#B3112230" CornerRadius="20" BorderBrush="#335366" BorderThickness="1" Padding="37">
     <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Canvas Grid.RowSpan="2" VerticalAlignment="Bottom" Height="240" Opacity=".17" IsHitTestVisible="False">
       <Rectangle Width="64" Height="160" Fill="#54B7B3" Canvas.Left="8" Canvas.Top="75"/>
       <Rectangle Width="90" Height="115" Fill="#3D7E92" Canvas.Left="78" Canvas.Top="120"/>
       <Rectangle Width="54" Height="210" Fill="#62D4BE" Canvas.Left="172" Canvas.Top="24"/>
       <Rectangle Width="85" Height="143" Fill="#438DA2" Canvas.Left="233" Canvas.Top="92"/>
       <Rectangle Width="70" Height="190" Fill="#5EB4A8" Canvas.Left="325" Canvas.Top="45"/>
       <Rectangle Width="120" Height="110" Fill="#438DA2" Canvas.Left="403" Canvas.Top="125"/>
      </Canvas>
      <StackPanel VerticalAlignment="Center">
       <Border Background="#243D47" CornerRadius="12" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,28">
        <TextBlock Text="●  ТВОЙ НОВЫЙ МИР" Foreground="#4DE9D4" FontSize="12" FontWeight="Bold"/>
       </Border>
       <TextBlock Text="ГОРОД ЖДЁТ&#10;ТЕБЯ." FontSize="57" FontWeight="Black" LineHeight="64"/>
       <Rectangle Fill="#36E7D1" Width="76" Height="5" HorizontalAlignment="Left" Margin="0,26,0,24" RadiusX="2" RadiusY="2"/>
       <TextBlock Text="Начни свою историю в MARCH ROLE PLAY" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="Выбирай свой путь, встречай игроков и создавай собственную историю." FontSize="14" Foreground="#A6C0CA" TextWrapping="Wrap" Margin="0,13,0,0" MaxWidth="420" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Row="1">
       <TextBlock x:Name="StatusText" Text="Сервер: 127.0.0.1:22003  •  Готов к запуску" Foreground="#A6C0CA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
       <Button x:Name="PlayButton" Content="▶   ИГРАТЬ СЕЙЧАС" Height="64" FontSize="20" Background="#0BAE9F" Click="PlayButton_Click"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border Grid.Column="2" Background="#D7101E2B" CornerRadius="20" BorderBrush="#335366" BorderThickness="1" Padding="27">
     <StackPanel>
      <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="23" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBlock Text="Адрес сервера уже указан — просто нажми «ИГРАТЬ»" Foreground="#A6C0CA" TextWrapping="Wrap" FontSize="13"/>
      <TextBlock Text="IP или домен сервера" Foreground="#A6C0CA" Margin="0,28,0,8"/>
      <TextBox x:Name="HostBox" Text="127.0.0.1" Height="42"/>
      <TextBlock Text="Порт MTA" Foreground="#A6C0CA" Margin="0,19,0,8"/>
      <TextBox x:Name="PortBox" Text="22003" Height="42"/>
      <TextBlock Text="Папка установленной MTA" Foreground="#A6C0CA" Margin="0,24,0,8"/>
      <TextBox x:Name="MtaPathBox" Height="42"/>
      <Button Content="ВЫБРАТЬ ПАПКУ MTA" Click="BrowseButton_Click" Margin="0,12,0,0" Background="#284453"/>
      <Border Background="#173540" CornerRadius="10" Padding="14" Margin="0,25,0,0">
       <TextBlock Text="Подключение откроется через установленный клиент MTA. IP и порт должны совпадать с сервером." Foreground="#A9D8DA" FontSize="12" TextWrapping="Wrap"/>
      </Border>
     </StackPanel>
    </Border>
   </Grid>
   <DockPanel Grid.Row="2" LastChildFill="False" VerticalAlignment="Bottom">
    <TextBlock Text="MARCH ROLE PLAY  /  LAUNCHER" Foreground="#668493" FontSize="11" DockPanel.Dock="Left"/>
    <TextBlock Text="WINDOWS 10 / 11   •   x64" Foreground="#668493" FontSize="11" DockPanel.Dock="Right"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>