<Window x:Class="MarchLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MARCH ROLE PLAY" Width="1380" Height="840" MinWidth="1150" MinHeight="780" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="#071018" Foreground="White" Opacity="0">
 <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard><Storyboard>
 <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.55" DecelerationRatio=".8"/>
 </Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
 <Window.Resources>
 <SolidColorBrush x:Key="Aqua" Color="#12D9D6"/>
 <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#D6E9F1"/><Setter Property="Background" Value="#142B38"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#091D29"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#275164"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Background" Value="#091D29"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#275164"/><Setter Property="Padding" Value="12"/></Style>
 </Window.Resources>
 <Border BorderBrush="#174254" BorderThickness="1">
 <Grid>
 <Grid.Background><ImageBrush ImageSource="/city-bg.png" Stretch="UniformToFill" Opacity=".48"/></Grid.Background>
 <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.Column="0" Background="#E9051720" BorderBrush="#1C3C4A" BorderThickness="0,0,1,0">
 <Grid Margin="17,22"><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Top"><TextBlock Text="MARCH" FontSize="38" FontWeight="Black" FontStyle="Italic" Foreground="{StaticResource Aqua}"/><TextBlock Text="R O L E  P L A Y" Margin="5,-5,0,0" FontSize="12" Foreground="White"/></StackPanel>
 <StackPanel Grid.Row="1" VerticalAlignment="Top">
 <Button Content="⌂   Главная" Background="#085C68" Foreground="White" FontSize="16" HorizontalContentAlignment="Left" Height="49"/>
 <Button Content="▤   Новости" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="NewsButton_Click"/>
 <Button Content="✦   Промокоды" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="PromoButton_Click"/>
 <Button Content="♙   Личный кабинет" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="AccountButton_Click"/>
 <Button Content="⚙   Настройки" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="SettingsButton_Click"/>
 </StackPanel>
 <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
 <TextBlock Text="БОЛЬШЕ, ЧЕМ ИГРА" Foreground="{StaticResource Aqua}" FontWeight="Bold" FontStyle="Italic" FontSize="19" TextWrapping="Wrap"/>
 <TextBlock Text="ОБЩЕНИЕ  •  РАЗВИТИЕ  •  СВОБОДА" Foreground="#7D9BAC" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,15"/>
 <TextBlock Text="MARCH ROLE PLAY" Foreground="#628396" FontSize="11"/>
 </StackPanel></Grid></Border>
 <Grid Grid.Column="1">
 <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Background="#C8081720" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
 <TextBlock Text="MARCH ROLE PLAY     |     Launcher v0.2.0" Margin="17,0" Foreground="#8AAABC" VerticalAlignment="Center" FontSize="12"/>
 <Button Grid.Column="1" Content="—" FontSize="19" Background="Transparent" Click="MinimizeButton_Click"/>
 <Button Grid.Column="2" Content="✕" FontSize="18" Background="Transparent" Click="CloseButton_Click"/>
 </Grid>
 <Grid Grid.Row="1" Margin="16,12,16,16">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="0.93*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="1.4*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Grid.Column="0" CornerRadius="10" BorderBrush="#1B5964" BorderThickness="1" ClipToBounds="True">
 <Grid>
 <Grid.Background><ImageBrush ImageSource="/city-bg.png" Stretch="UniformToFill"/></Grid.Background>
 <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CC06131C" Offset="0"/><GradientStop Color="#7706131C" Offset=".48"/><GradientStop Color="#1806131C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>

 <StackPanel Margin="30,24,30,20" VerticalAlignment="Top" HorizontalAlignment="Left">
 <TextBlock Text="MARCH" Foreground="{StaticResource Aqua}" FontSize="62" FontWeight="Black" FontStyle="Italic"/>
 <TextBlock Text="R O L E   P L A Y" FontSize="19" FontWeight="Bold" Margin="8,-10,0,15"/>
 <TextBlock Text="ТВОЙ НОВЫЙ МИР" FontSize="18" FontWeight="Bold" Margin="8,9,0,5"/>
 <TextBlock Text="Уникальный мир, где ты можешь быть кем угодно" FontSize="12" Foreground="#D5E6EB" Margin="8,0,0,0" TextWrapping="Wrap"/>
 </StackPanel>
 </Grid></Border>
 <Border Grid.Row="0" Grid.Column="2" CornerRadius="10" Background="#EF081B25" BorderBrush="#1B4E5A" BorderThickness="1" Padding="17">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
 <TextBlock Text="СТАТУС СЕРВЕРА" FontSize="17" FontWeight="Bold"/>
 <TextBlock Text="●  Мониторинг не подключён" Foreground="#E8BA79" FontSize="12" Margin="0,9,0,0"/>
 </StackPanel>
 <Grid Grid.Row="1" Margin="0,11,0,9">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
 <TextBlock Text="АДРЕС СЕРВЕРА" Foreground="#8EAFC0" FontSize="11"/>
 <TextBlock x:Name="ServerAddressText" Text="127.0.0.1:22003" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,8"/>
 </StackPanel>
 <StackPanel Grid.Row="1"><TextBlock Text="ИГРОКОВ ОНЛАЙН" Foreground="#8EAFC0" FontSize="11"/><TextBlock Text="— / —" FontSize="16" Margin="0,3,0,0"/></StackPanel>
 <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="СТАТУС" Foreground="#8EAFC0" FontSize="11"/><TextBlock Text="Неизвестен" FontSize="15" Margin="0,3,0,0"/></StackPanel>
 </Grid>
 <Button Grid.Row="2" Content="▶  ПОДКЛЮЧИТЬСЯ" Height="43" Background="#00B8B5" Foreground="#031923" FontSize="14" FontWeight="Bold" Click="PlayButton_Click"/>
 </Grid></Border>
 <Border Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" CornerRadius="10" Background="#E3081B25" BorderBrush="#1B4E5A" BorderThickness="1" Padding="19">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock Text="ПОСЛЕДНИЕ НОВОСТИ" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>
 <Border BorderBrush="#193F4D" BorderThickness="0,0,0,1" Padding="5,13"><StackPanel><TextBlock Text="Открытие MARCH ROLE PLAY" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Добро пожаловать в наш игровой мир!" Foreground="#8DAAB8" Margin="0,6,0,0"/></StackPanel></Border>
 <Border BorderBrush="#193F4D" BorderThickness="0,0,0,1" Padding="5,13"><StackPanel><TextBlock Text="Новости проекта" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Актуальные объявления появятся после подключения новостного API." Foreground="#8DAAB8" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
 <Border Padding="5,13"><StackPanel><TextBlock Text="Сообщество MARCH ROLE PLAY" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Следи за новостями и событиями проекта." Foreground="#8DAAB8" Margin="0,6,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Border>
 <Border Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" CornerRadius="10" Background="#EF081B25" BorderBrush="#1B4E5A" BorderThickness="1" Padding="17">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="НАСТРОЙКИ ПОДКЛЮЧЕНИЯ" FontWeight="Bold" FontSize="16"/>
 <StackPanel Grid.Row="1" Margin="0,10,0,0">
 <TextBlock Text="IP / домен" Foreground="#8DAAB8" FontSize="11"/>
 <TextBox x:Name="HostBox" Text="127.0.0.1" Padding="9,6" FontSize="13" Margin="0,3,0,7" TextChanged="ConnectionTextChanged"/>
 <TextBlock Text="Порт" Foreground="#8DAAB8" FontSize="11"/>
 <TextBox x:Name="PortBox" Text="22003" Padding="9,6" FontSize="13" Margin="0,3,0,7" TextChanged="ConnectionTextChanged"/>
 <TextBlock Text="Папка MTA (необязательно)" Foreground="#8DAAB8" FontSize="11"/>
 <TextBox x:Name="MtaPathBox" Padding="9,6" FontSize="12" Margin="0,3,0,7"/>
 <Button Content="ВЫБРАТЬ ПАПКУ MTA" Height="34" Padding="8,4" FontSize="12" Click="BrowseButton_Click"/>
 <TextBlock Text="Настройки сохраняются при запуске игры." Foreground="#7795A6" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
 </StackPanel>
 </Grid></Border>
 <Border Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" CornerRadius="10" Background="#E3081B25" BorderBrush="#1B4E5A" BorderThickness="1" Padding="15">
 <StackPanel><TextBlock Text="MARCH ROLE PLAY  •  Лаунчер готов" FontWeight="SemiBold" Foreground="{StaticResource Aqua}"/><TextBlock x:Name="StatusText" Text="Для запуска нажми «ИГРАТЬ»" Foreground="#9BB6C4" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 <Button Grid.Row="2" Grid.Column="2" x:Name="PlayButton" Content="▶   ИГРАТЬ" Background="#00B8B5" Foreground="#031923" FontSize="23" FontWeight="Bold" Margin="0,12,0,0" Click="PlayButton_Click"/>
 </Grid></Grid></Grid></Border>
</Window>