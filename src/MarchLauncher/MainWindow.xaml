<Window x:Class="MarchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MARCH ROLE PLAY" Height="680" Width="1120"
        MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen"
        Background="#0B1015" Foreground="#F2F7F8">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#263A45" Offset="0"/>
                <GradientStop Color="#111B22" Offset="0.48"/>
                <GradientStop Color="#080C11" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B80A1118" Padding="30,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="MARCH" FontSize="27" FontWeight="Bold" Foreground="#20D6C7"/>
                    <TextBlock Text=" ROLE PLAY" FontSize="27" FontWeight="Light" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="ОФИЦИАЛЬНЫЙ ИГРОВОЙ ЛАУНЧЕР" Foreground="#91A4AA"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="34,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="16" Background="#70202D36" Padding="34">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТВОЯ ИСТОРИЯ&#10;НАЧИНАЕТСЯ ЗДЕСЬ" FontSize="34"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Погрузись в мир MARCH ROLE PLAY" Foreground="#20D6C7"
                                   FontSize="16" Margin="0,18,0,0"/>
                        <TextBlock Text="Выбери папку Multi Theft Auto, проверь подключение и отправляйся в игру."
                                   Foreground="#B5C2C6" FontSize="14" TextWrapping="Wrap"
                                   MaxWidth="430" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="StatusText" Text="Лаунчер готов к настройке"
                                   Foreground="#91A4AA" Margin="0,0,0,12"/>
                        <Button x:Name="PlayButton" Content="ИГРАТЬ" FontSize="16"
                                Height="54" Click="PlayButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="16" Background="#D9162028" Padding="25">
                <StackPanel>
                    <TextBlock Text="НАСТРОЙКИ" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Путь к Multi Theft Auto" Foreground="#91A4AA" Margin="0,24,0,8"/>
                    <TextBox x:Name="MtaPathBox" Height="38" Padding="9"
                             Background="#18242C" Foreground="White" BorderBrush="#35454D"/>
                    <Button Content="ВЫБРАТЬ ПАПКУ" Margin="0,10,0,0"
                            Click="BrowseButton_Click"/>
                    <TextBlock Text="Адрес сервера" Foreground="#91A4AA" Margin="0,24,0,8"/>
                    <TextBox x:Name="HostBox" Text="127.0.0.1" Height="38" Padding="9"
                             Background="#18242C" Foreground="White" BorderBrush="#35454D"/>
                    <TextBlock Text="Порт" Foreground="#91A4AA" Margin="0,18,0,8"/>
                    <TextBox x:Name="PortBox" Text="22003" Height="38" Padding="9"
                             Background="#18242C" Foreground="White" BorderBrush="#35454D"/>
                    <TextBlock Text="Параметры сохраняются на этом компьютере."
                               Foreground="#71858B" FontSize="11" TextWrapping="Wrap" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#C8080D12" Padding="30,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="MARCH ROLE PLAY" Foreground="#71858B" FontSize="12"/>
                <TextBlock Text="Windows 10 / 11  •  x64" Foreground="#71858B"
                           FontSize="12" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
