<Window x:Class="MarchLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MARCH ROLE PLAY" Width="1536" Height="930" MinWidth="1200" MinHeight="800" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="#071018" Foreground="White" Opacity="0">
 <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard><Storyboard>
 <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.55" DecelerationRatio=".8"/>
 </Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
 <Window.Resources>
 <SolidColorBrush x:Key="Aqua" Color="#0CF1ED"/>
 <DropShadowEffect x:Key="NeonGlow" Color="#00F3EF" BlurRadius="18" ShadowDepth="0" Opacity=".58"/>
 <Style x:Key="GlowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#06333B"/><Setter Property="Foreground" Value="#E8FFFF"/><Setter Property="BorderBrush" Value="#08D9D8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect" Value="{StaticResource NeonGlow}"/></Style>
 <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#D6E9F1"/><Setter Property="Background" Value="#142B38"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#091D29"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#275164"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Background" Value="#091D29"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#275164"/><Setter Property="Padding" Value="12"/></Style>
 </Window.Resources>
 <Border BorderBrush="#174254" BorderThickness="1">
 <Grid>
 <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#07131C" Offset="0"/><GradientStop Color="#031017" Offset=".55"/><GradientStop Color="#061A24" Offset="1"/></LinearGradientBrush></Grid.Background>
 <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.Column="0" BorderBrush="#1C3C4A" BorderThickness="0,0,1,0"><Border.Background><ImageBrush ImageSource="/news3.jpg" Stretch="UniformToFill" Opacity=".25"/></Border.Background>
 <Grid Margin="17,22"><Grid.Background><SolidColorBrush Color="#C8031018"/></Grid.Background><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Top"><TextBlock Text="MARCH" FontSize="48" FontWeight="Black" FontStyle="Italic" Foreground="{StaticResource Aqua}" Effect="{StaticResource NeonGlow}"/><TextBlock Text="R O L E  P L A Y" Margin="5,-5,0,0" FontSize="12" Foreground="White"/></StackPanel>
 <StackPanel Grid.Row="1" VerticalAlignment="Top">
 <Button Content="⌂   Главная" Background="#007D89" Effect="{StaticResource NeonGlow}" Foreground="White" FontSize="16" HorizontalContentAlignment="Left" Height="49"/>
 <Button Content="▤   Новости" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="NewsButton_Click"/>
 <Button Content="✦   Промокоды" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="PromoButton_Click"/>
 <Button Content="♙   Личный кабинет" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="AccountButton_Click"/>
 <Button Content="⚙   Настройки" HorizontalContentAlignment="Left" FontSize="16" Margin="0,9,0,0" Click="SettingsButton_Click"/>
 </StackPanel>
 <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="◉       VK       ➤" FontSize="19" Foreground="#90C3D2" Margin="0,0,0,18"/>
 <TextBlock Text="БОЛЬШЕ, ЧЕМ ИГРА" Foreground="{StaticResource Aqua}" FontWeight="Bold" FontStyle="Italic" FontSize="19" TextWrapping="Wrap"/>
 <TextBlock Text="ОБЩЕНИЕ  •  РАЗВИТИЕ  •  СВОБОДА" Foreground="#7D9BAC" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,15"/>
 <TextBlock Text="MARCH ROLE PLAY" Foreground="#628396" FontSize="11"/>
 </StackPanel></Grid></Border>
 <Grid Grid.Column="1">
 <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Background="#C8081720" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
 <TextBlock Text="MARCH ROLE PLAY     |     Launcher v0.2.0" Margin="17,0" Foreground="#8AAABC" VerticalAlignment="Center" FontSize="12"/>
 <Button Grid.Column="1" Content="—" FontSize="19" Background="Transparent" Click="MinimizeButton_Click"/>
 <Button Grid.Column="2" Content="✕" FontSize="18" Background="Transparent" Click="CloseButton_Click"/>
 </Grid>
 <Grid Grid.Row="1" Margin="16,12,16,16">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.85*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="1.55*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" BorderBrush="#315260" BorderThickness="1" ClipToBounds="True">
 <Grid>
 <Grid.Background><ImageBrush ImageSource="/hero.jpg" Stretch="UniformToFill"/></Grid.Background>
 <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CC06131C" Offset="0"/><GradientStop Color="#7706131C" Offset=".48"/><GradientStop Color="#1806131C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>

 <StackPanel Margin="34,28,30,20" VerticalAlignment="Top" HorizontalAlignment="Left">
 <TextBlock Text="MARCH" Foreground="{StaticResource Aqua}" FontSize="108" FontWeight="Black" FontStyle="Italic"><TextBlock.Effect><DropShadowEffect Color="#00F5F0" BlurRadius="15" ShadowDepth="0" Opacity=".6"/></TextBlock.Effect></TextBlock>
 <TextBlock Text="R O L E   P L A Y" FontSize="21" FontWeight="Bold" Margin="8,-10,0,15"/>
 
 <TextBlock Text="Уникальный мир, где ты можешь быть кем угодно" FontSize="14" Foreground="#F0F8FA" Margin="8,48,0,0" TextWrapping="Wrap"/>
 </StackPanel>
 </Grid></Border>
 <Border Grid.Row="0" Grid.Column="2" CornerRadius="15" Background="#F5081922" BorderBrush="#24515D" BorderThickness="1" Padding="22">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
 <TextBlock Text="СТАТУС СЕРВЕРА" FontSize="17" FontWeight="Bold"/>
 <TextBlock Text="●  Мониторинг не подключён" Foreground="#E8BA79" FontSize="12" Margin="0,9,0,0"/>
 </StackPanel>
 <Grid Grid.Row="1" Margin="0,11,0,9">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
 <TextBlock Text="АДРЕС СЕРВЕРА" Foreground="#8EAFC0" FontSize="11"/>
 <TextBlock x:Name="ServerAddressText" Text="127.0.0.1:22003" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,8"/>
 </StackPanel>
 <StackPanel Grid.Row="1"><TextBlock Text="ИГРОКОВ ОНЛАЙН" Foreground="#8EAFC0" FontSize="11"/><TextBlock Text="— / —" FontSize="16" Margin="0,3,0,0"/></StackPanel>
 <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="СТАТУС" Foreground="#8EAFC0" FontSize="11"/><TextBlock Text="Неизвестен" FontSize="15" Margin="0,3,0,0"/></StackPanel>
 </Grid>
 <Button Grid.Row="2" Content="🔗  ПОДКЛЮЧИТЬСЯ" Height="48" Style="{StaticResource GlowButton}" FontSize="14" FontWeight="Bold" Click="PlayButton_Click"/>
 </Grid></Border>
 <Border Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" CornerRadius="15" Background="#F0081922" BorderBrush="#24515D" BorderThickness="1" Padding="19,15">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel><TextBlock Text="▤   Последние новости" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Все новости  →" Foreground="#15D9DA" HorizontalAlignment="Right" Margin="28,4,0,0"/></DockPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
 <StackPanel>
 <Border BorderBrush="#204756" BorderThickness="0,0,0,1" Padding="0,8"><Grid Height="83"><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border CornerRadius="7" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="/news1.jpg" Stretch="UniformToFill" Viewbox="0.3,0.05,0.42,0.5" ViewboxUnits="RelativeToBoundingBox"/></Border.Background></Border>
 <StackPanel Grid.Column="1" Margin="16,2,0,0"><TextBlock Text="Открытие проекта MARCH ROLE PLAY" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Добро пожаловать в наш игровой мир!" Foreground="#A7C3D1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="Новости проекта" Foreground="#4ED6D5" FontSize="11" Margin="0,7,0,0"/></StackPanel>
 </Grid></Border>
 <Border BorderBrush="#204756" BorderThickness="0,0,0,1" Padding="0,8"><Grid Height="83"><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border CornerRadius="7" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="/news2.jpg" Stretch="UniformToFill" Viewbox="0.52,0.48,0.44,0.45" ViewboxUnits="RelativeToBoundingBox"/></Border.Background></Border>
 <StackPanel Grid.Column="1" Margin="16,2,0,0"><TextBlock Text="Разработка сервера" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Следи за новостями разработки и изменениями проекта." Foreground="#A7C3D1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="Обновления" Foreground="#4ED6D5" FontSize="11" Margin="0,7,0,0"/></StackPanel>
 </Grid></Border>
 <Border BorderBrush="#204756" BorderThickness="0,0,0,1" Padding="0,8"><Grid Height="83"><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border CornerRadius="7" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="/news3.jpg" Stretch="UniformToFill" Viewbox="0.02,0.12,0.4,0.6" ViewboxUnits="RelativeToBoundingBox"/></Border.Background></Border>
 <StackPanel Grid.Column="1" Margin="16,2,0,0"><TextBlock Text="Промокоды" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Акции и бонусы появятся после запуска сервера." Foreground="#A7C3D1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="Акции" Foreground="#4ED6D5" FontSize="11" Margin="0,7,0,0"/></StackPanel>
 </Grid></Border>
 <Border Padding="0,8"><Grid Height="83"><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border CornerRadius="7" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="/news4.jpg" Stretch="UniformToFill" Viewbox="0.2,0.15,0.5,0.55" ViewboxUnits="RelativeToBoundingBox"/></Border.Background></Border>
 <StackPanel Grid.Column="1" Margin="16,2,0,0"><TextBlock Text="Сообщество MARCH ROLE PLAY" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Общайся с игроками и узнавай новости проекта." Foreground="#A7C3D1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="Сообщество" Foreground="#4ED6D5" FontSize="11" Margin="0,7,0,0"/></StackPanel>
 </Grid></Border>
 </StackPanel></ScrollViewer>
 </Grid></Border>
 <Border Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" CornerRadius="15" Background="#F5081922" BorderBrush="#24515D" BorderThickness="1" Padding="18">
 <TabControl x:Name="RightTabs" Background="Transparent" BorderThickness="0" Foreground="White">
 <TabControl.Resources>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B4D1E0"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="13,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" BorderBrush="#174A58" BorderThickness="0,0,0,2" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#12D9D6"/><Setter Property="Foreground" Value="#12D9D6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </TabControl.Resources>
 <TabItem Header="Вход">
 <StackPanel Margin="9,20,9,0">
 <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>
 <TextBox IsEnabled="False" Text="Логин" Height="44" Margin="0,0,0,13"/>
 <PasswordBox IsEnabled="False" Height="44" Margin="0,0,0,13"/>
 <CheckBox IsEnabled="False" Content="Запомнить меня" Foreground="#8FAABB" Margin="0,0,0,17"/>
 <Button IsEnabled="False" Content="ВОЙТИ" Height="46" Background="#00B8B5" Foreground="#061822" FontSize="16" FontWeight="Bold"/>
 <TextBlock Text="Вход будет доступен после подключения API сервера march_auth." Foreground="#92B4C1" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"/>
 </StackPanel></TabItem>
 <TabItem Header="Регистрация">
 <StackPanel Margin="9,20,9,0">
 <TextBlock Text="СОЗДАТЬ АККАУНТ" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
 <TextBox IsEnabled="False" Text="Логин" Height="42" Margin="0,0,0,12"/>
 <PasswordBox IsEnabled="False" Height="42" Margin="0,0,0,12"/>
 <PasswordBox IsEnabled="False" Height="42" Margin="0,0,0,16"/>
 <Button IsEnabled="False" Content="ЗАРЕГИСТРИРОВАТЬСЯ" Height="45" Background="#00B8B5"/>
 <TextBlock Text="Регистрация появится после настройки безопасного серверного API." Foreground="#92B4C1" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
 </StackPanel></TabItem>
 <TabItem Header="Настройки">
 <StackPanel Margin="9,16,9,0">
 <TextBlock Text="ПОДКЛЮЧЕНИЕ К MTA" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>
 <TextBlock Text="СЕРВЕР MARCH ROLE PLAY" Foreground="#8DAAB8" FontSize="11"/>
 <TextBlock Text="127.0.0.1:22003" Foreground="#0CF1ED" FontWeight="Bold" FontSize="20" Margin="0,6,0,9"/>
 <TextBlock Text="Адрес сервера установлен автоматически и не изменяется." Foreground="#A5C3CF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,19"/>
 <TextBlock Text="Папка MTA (необязательно)" Foreground="#8DAAB8" FontSize="11"/>
 <TextBox x:Name="MtaPathBox" Padding="9,6" FontSize="12" Margin="0,5,0,10"/>
 <Button Content="ВЫБРАТЬ ПАПКУ MTA" Height="38" Click="BrowseButton_Click"/>
 <TextBlock Text="Для подключения нажми «Играть»." Foreground="#7795A6" TextWrapping="Wrap" FontSize="11" Margin="0,16,0,0"/>
 </StackPanel></TabItem>
 </TabControl>
 </Border>
 <Border Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" CornerRadius="15" Background="#E3081B25" BorderBrush="#24515D" BorderThickness="1" Padding="15">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⇩" FontSize="31" Foreground="{StaticResource Aqua}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Проверка обновлений пока недоступна" FontWeight="SemiBold" Foreground="#D6F0F4"/><TextBlock x:Name="StatusText" Text="Для запуска нажми «ИГРАТЬ»" Foreground="#9BB6C4" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
 <Button Grid.Row="2" Grid.Column="2" x:Name="PlayButton" Content="▶   ИГРАТЬ" Effect="{StaticResource NeonGlow}" Background="#00E5DF" Foreground="#031923" FontSize="23" FontWeight="Bold" Margin="0,12,0,0" Click="PlayButton_Click"/>
 </Grid></Grid></Grid></Border>
</Window>