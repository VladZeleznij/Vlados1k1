<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MARCH ROLE PLAY Launcher</AssemblyName>
    <RootNamespace>MarchLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>march.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="city-bg.png" /><Resource Include="hero.jpg" /><Resource Include="news1.jpg" /><Resource Include="news2.jpg" /><Resource Include="news3.jpg" /><Resource Include="news4.jpg" /></ItemGroup>
</Project>
